# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PATHAO_WEBHOOK_SECRET: Secret for Pathao Courier Webhook integration verification
PATHAO_WEBHOOK_SECRET="f3992ecc-59da-4cbe-a049-a13da2018d51"

# PATHAO API CREDENTIALS (from merchant.pathao.com > Developer API & Stores)
PATHAO_BASE_URL="https://api-hermes.pathao.com"
PATHAO_CLIENT_ID="YOUR_PATHAO_CLIENT_ID"
PATHAO_CLIENT_SECRET="YOUR_PATHAO_CLIENT_SECRET"
PATHAO_USERNAME="YOUR_PATHAO_LOGIN_EMAIL"
PATHAO_PASSWORD="YOUR_PATHAO_LOGIN_PASSWORD"
PATHAO_STORE_ID="YOUR_PATHAO_STORE_ID"

# META / FACEBOOK / INSTAGRAM / WHATSAPP INTEGRATION
# Common Meta App Credentials (developers.facebook.com)
META_APP_ID="YOUR_META_APP_ID"
META_APP_SECRET="YOUR_META_APP_SECRET"
META_VERIFY_TOKEN="vistoosa_meta_secret_token_2026"

# Facebook Page Messenger Credentials
PAGE_ACCESS_TOKEN="YOUR_LONG_LIVED_PAGE_ACCESS_TOKEN"
PAGE_ID="YOUR_FACEBOOK_PAGE_ID"

# Instagram Professional / Business Account ID
INSTAGRAM_BUSINESS_ACCOUNT_ID="YOUR_INSTAGRAM_BUSINESS_ACCOUNT_ID"

# WhatsApp Business Cloud API Credentials
WHATSAPP_PHONE_NUMBER_ID="YOUR_WHATSAPP_PHONE_NUMBER_ID"
WHATSAPP_BUSINESS_ACCOUNT_ID="YOUR_WHATSAPP_BUSINESS_ACCOUNT_ID"
WHATSAPP_ACCESS_TOKEN="YOUR_WHATSAPP_ACCESS_TOKEN"
