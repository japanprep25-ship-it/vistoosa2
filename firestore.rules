rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny catch-all for unmatched documents
    match /{document=**} {
      allow read, write: if false;
    }

    // Public branding metadata (logo, favicon, app icons)
    match /settings/branding {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
