rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Public branding metadata
    match /settings/branding {
      allow read, write: if true;
    }

    // Orders Collection
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
